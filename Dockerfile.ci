ARG GO_VERSION=1.27.1
ARG NODE_VERSION=26.8.1
ARG ALPINE_VERSION=3.24
ARG TRIVY_VERSION=0.74.0

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH

FROM --platform=${BUILDPLATFORM} golang:${GO_VERSION}-alpine${ALPINE_VERSION} AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -ldflags="-s -w" -o /out/golden-retriever ./cmd/golden-retriever

FROM --platform=${TARGETPLATFORM} node:${NODE_VERSION}-alpine${ALPINE_VERSION}
ARG TRIVY_VERSION
RUN apk upgrade --no-cache \
  && apk add --no-cache ca-certificates osv-scanner wget \
  && trivy_arch="$(uname -m)" \
  && case "$trivy_arch" in x86_64) trivy_arch="64bit" ;; aarch64) trivy_arch="ARM64" ;; armv7*) trivy_arch="ARM" ;; *) echo "unsupported Trivy arch: $trivy_arch" >&2; exit 1 ;; esac \
  && wget -O /tmp/trivy.tar.gz "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-${trivy_arch}.tar.gz" \
  && tar -xzf /tmp/trivy.tar.gz -C /usr/local/bin trivy \
  && chmod +x /usr/local/bin/trivy \
  && rm -f /tmp/trivy.tar.gz \
  && osv-scanner --version \
  && trivy --version \
  && npm cache clean --force \
  && npm --version \
  && node --version \
  && mkdir -p /workspace
COPY --from=builder /out/golden-retriever /usr/local/bin/golden-retriever
WORKDIR /workspace
